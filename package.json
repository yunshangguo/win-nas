{
  "name": "nas-file-manager",
  "version": "0.2.0",
  "private": true,
  "description": "Windows-native NAS-style file manager: TUS resumable upload, recycle-bin integration, system-drive guard, zip compress/extract with AES",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "electron:dev": "electron .",
    "dist": "electron-builder --win --x64",
    "dist:portable": "electron-builder --win portable --x64"
  },
  "build": {
    "appId": "com.yunshangguo.nasmanager",
    "productName": "NasManager",
    "copyright": "Copyright © 2026 yunshangguo",
    "directories": { "output": "dist", "buildResources": "build" },
    "asarUnpack": ["**/*.node"],
    "files": [
      "package.json",
      "server.js",
      "config.js",
      "src/**/*",
      "public/**/*",
      ".env.example",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/electron{,/**}",
      "!node_modules/electron-builder{,/**}",
      "!node_modules/.bin/**",
      "!node_modules/pkg{,/**}",
      "!node_modules/@yao-pkg/**",
      "!release/**"
    ],
    "win": {
      "target": [{ "target": "portable", "arch": "x64" }],
      "artifactName": "NasManager-${version}-win-x64-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@tus/file-store": "^1.5.0",
    "@tus/server": "^1.10.0",
    "acme-client": "^5.4.0",
    "archiver": "^6.0.1",
    "archiver-zip-encrypted": "^1.0.5",
    "express": "^4.19.2",
    "html-to-docx": "^1.8.0",
    "mammoth": "^1.8.0",
    "sharp": "^0.33.5",
    "xlsx": "^0.18.5",
    "yauzl": "^3.4.0"
  }
}
