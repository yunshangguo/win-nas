# ============================================================
# NasManager 配置样例 —— 复制为 .env 后按需修改
# ============================================================

# 应用数据目录：索引 / 缩略图 / 上传临时 / 数据库 全部存这里
# 默认 = 项目安装目录下的 data/（<项目>/data），与盘符解耦，单 C 盘机器也能用。
# 取消下一行注释可改到独立数据盘（例如 DATA_DIR=D:\NasManagerData）。
# 落到系统盘不再拒绝启动，仅打印警告（如需严格拒绝可设 ALLOW_DATA_ON_SYSTEM=0）。
# DATA_DIR=D:\NasManagerData

# 系统盘列表：这些盘上的文件操作需二次确认（逗号或分号分隔，不带冒号）
SYSTEM_DRIVES=C

# 用户个人主目录基地：默认 = 项目安装目录下的 home/（<项目>/home/<用户名>）。
# 取消下一行注释可改到其它位置（例如 USER_HOME_BASE=D:\NasManagerHome）。
# USER_HOME_BASE=D:\NasManagerHome

# 用户文件根目录：名称:路径，可多个，分号分隔
# 软件管理的“原文件”就放在这些目录，Explorer 直接可读
ROOTS=share:D:\Share

# 监听端口
PORT=8080

# ===== 登录认证（强制开启，所有 API 必须登录后访问） =====
# 管理员用户名（默认 admin）
AUTH_USERNAME=admin
# 管理员密码。留空则首次启动自动生成随机密码并写入 DATA_DIR/secrets/initial_admin_password.txt
# 公网暴露前务必设一个强密码
# AUTH_PASSWORD=你的强密码

# ===== 传输加密（HTTPS，强烈建议公网开启） =====
# 方式一：本机直接 TLS —— 填证书与私钥的绝对路径（PEM 格式）
# HTTPS_CERT=D:\NasManager\cert\fullchain.pem
# HTTPS_KEY=D:\NasManager\cert\privkey.pem
# 方式二（推荐）：用 Caddy 反代本机 http://localhost:8080，自动签发 Let's Encrypt（见 Caddyfile）

